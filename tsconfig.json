{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM"],
    "strict": false, "noImplicitAny": false, "noImplicitThis": true, "strictNullChecks": false,
    "noEmit": true, "skipLibCheck": true, "allowJs": false, "esModuleInterop": true, "resolveJsonModule": true
  },
  "include": ["src"]
}
