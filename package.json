{
  "name": "dotville",
  "version": "0.1.0",
  "private": true,
  "description": "A tiny shared world of dots living their lives, with their own language.",
  "main": "dist/server.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build --silent && node dist/server.js",
    "dev": "tsx watch src/server/main.ts",
    "bench": "tsx src/tools/bench.ts",
    "typecheck": "tsc -p . && node scripts/typing-ratchet.mjs",
    "test": "tsx --test tests/*.test.ts",
    "map": "tsx src/tools/map.ts",
    "report": "python3 ml/balance_report.py",
    "gazette": "tsx src/tools/gazette.ts",
    "reality": "tsx src/tools/reality.ts",
    "rates": "tsx src/tools/rates.ts",
    "preage": "tsx src/tools/preage.ts",
    "longrun": "tsx src/tools/longrun.ts",
    "loadtest": "tsx src/tools/loadtest.ts",
    "longreport": "python3 ml/long_report.py",
    "visual:baseline": "node scripts/build.mjs && node tests/visual/capture.cjs data/visual/golden",
    "visual:check": "node scripts/build.mjs && node tests/visual/capture.cjs data/visual/new && node tests/visual/diff.cjs data/visual/golden data/visual/new",
    "visual:seams": "node scripts/build.mjs && node tests/visual/seams.cjs",
    "speech": "tsx src/tools/speech.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "type": "commonjs"
}
